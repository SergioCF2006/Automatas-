			<pop>VERB</pop>
			<push/>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>ADJ</read>
			<pop>ADJ</pop>
			<push/>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>ADV</read>
			<pop>ADV</pop>
			<push/>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>PREP</read>
			<pop>PREP</pop>
			<push/>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>CONJ</read>
			<pop>CONJ</pop>
			<push/>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>PUNTO</read>
			<pop>PUNTO</pop>
			<push/>
		</transition>

		<!-- Transición de aceptación final al vaciarse la pila -->
		<transition>
			<from>1</from>
			<to>2</to>
			<read/>
			<pop>Z</pop>
			<push/>
		</transition>
	</automaton>
</structure>

