			<read/>
			<pop>MOD_VERB</pop>
			<push/>
		</transition>
		<!-- (19) COMPLEMENTOS -> COMP COMPLEMENTOS -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>COMPLEMENTOS</pop>
			<push>COMP COMPLEMENTOS</push>
		</transition>
		<!-- (20) COMPLEMENTOS -> ε -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>COMPLEMENTOS</pop>
			<push/>
		</transition>
		<!-- (21) COMP -> SP -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>COMP</pop>
			<push>SP</push>
		</transition>
		<!-- (22) COMP -> SN -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>COMP</pop>
			<push>SN</push>
		</transition>
		<!-- (23) COMP -> ADV -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>COMP</pop>
			<push>ADV</push>
		</transition>

		<!-- Transiciones de emparejamiento (Match) de terminales -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read>ART</read>
			<pop>ART</pop>
			<push/>
		</transition>
		<transition>
			<from>1</from>
