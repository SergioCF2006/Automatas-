<?xml version="1.0" encoding="UTF-8"?>
<!-- Autómata de Pila para Español - Generado para JFLAP -->
<structure>
	<type>pda</type>
	<automaton>
		<!-- Estados del Autómata -->
		<state id="0" name="q0">
			<x>100.0</x>
			<y>180.0</y>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>320.0</x>
			<y>180.0</y>
		</state>
		<state id="2" name="q2">
			<x>540.0</x>
			<y>180.0</y>
			<final/>
