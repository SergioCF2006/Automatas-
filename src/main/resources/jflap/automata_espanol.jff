		<!-- Transiciones del Autómata -->
		<!-- Transición inicial de configuración -->
		<transition>
			<from>0</from>
			<to>1</to>
			<read/>
			<pop>Z</pop>
			<push>OZ</push>
		</transition>

		<!-- Transiciones de expansión de no terminales (Reglas de producción) -->
		<!-- (1) O -> CLAUSULA O_PRIME -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>O</pop>
			<push>CLAUSULA O_PRIME</push>
		</transition>
		<!-- (2) O_PRIME -> CONJ CLAUSULA O_PRIME -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>O_PRIME</pop>
			<push>CONJ CLAUSULA O_PRIME</push>
		</transition>
		<!-- (3) O_PRIME -> PUNTO -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>O_PRIME</pop>
			<push>PUNTO</push>
		</transition>
		<!-- (4) CLAUSULA -> SUJETO PREDICADO -->
		<transition>
