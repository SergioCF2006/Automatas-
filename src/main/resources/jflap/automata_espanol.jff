		<!-- (6) COORDINACION_SN -> CONJ SN COORDINACION_SN -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>COORDINACION_SN</pop>
			<push>CONJ SN COORDINACION_SN</push>
		</transition>
		<!-- (7) COORDINACION_SN -> ε -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>COORDINACION_SN</pop>
			<push/>
		</transition>
		<!-- (8) SN -> PRON -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>SN</pop>
			<push>PRON</push>
		</transition>
		<!-- (9) SN -> GRUPO_NOMINAL -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>SN</pop>
			<push>GRUPO_NOMINAL</push>
		</transition>
		<!-- (10) GRUPO_NOMINAL -> ART SUST_COMPUESTO -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>GRUPO_NOMINAL</pop>
			<push>ART SUST_COMPUESTO</push>
		</transition>
		<!-- (11) GRUPO_NOMINAL -> SUST_COMPUESTO -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>GRUPO_NOMINAL</pop>
			<push>SUST_COMPUESTO</push>
		</transition>
		<!-- (12) SUST_COMPUESTO -> SUST MOD_SUST -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>SUST_COMPUESTO</pop>
			<push>SUST MOD_SUST</push>
		</transition>
		<!-- (13) MOD_SUST -> ADJ MOD_SUST -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>MOD_SUST</pop>
			<push>ADJ MOD_SUST</push>
		</transition>
		<!-- (14) MOD_SUST -> ε -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>MOD_SUST</pop>
			<push/>
		</transition>
		<!-- (15) SP -> PREP SN -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>SP</pop>
			<push>PREP SN</push>
		</transition>
		<!-- (16) PREDICADO -> MOD_VERB VERB COMPLEMENTOS -->
		<transition>
			<from>1</from>
			<to>1</to>
			<read/>
			<pop>PREDICADO</pop>
			<push>MOD_VERB VERB COMPLEMENTOS</push>
		</transition>
		<!-- (17) MOD_VERB -> ADV -->
		<transition>
			<from>1</from>
			<to>1</to>
